{
    "$schema": "https://schema.tauri.app/config/2",
    "productName": "tonic",
    "version": "0.1.0",
    "identifier": "com.andude.tonic",
    "build": {
        "beforeDevCommand": "pnpm --dir ../webview-frontend dev",
        "devUrl": "http://127.0.0.1:1420",
        "beforeBuildCommand": "pnpm --dir ../webview-frontend build",
        "frontendDist": "../webview-frontend/build"
    },
    "app": {
        "windows": [
            {
                "title": "tonic",
                "width": 1200,
                "height": 800,
                "decorations": false,
                "transparent": true,
                "backgroundColor": "#2a2b2d",
                "visible": false
            }
        ],
        "security": {
            "csp": null
        }
    },
    "bundle": {
        "active": true,
        "targets": "all",
        "icon": [
            "desktop-icons/32x32.png",
            "desktop-icons/128x128.png",
            "desktop-icons/128x128@2x.png",
            "desktop-icons/icon.icns",
            "desktop-icons/icon.ico"
        ]
    }
}
